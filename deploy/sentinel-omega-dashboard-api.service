[Unit]
Description=Sentinel Omega Dashboard API (FastAPI)
After=network-online.target sentinel-omega.service
Wants=network-online.target

[Service]
Type=simple
User=deamon
WorkingDirectory=/home/deamon/workspaces/sentinel_omega
EnvironmentFile=/home/deamon/workspaces/deploy/.env
ExecStart=/home/deamon/workspaces/.venv/bin/python -m uvicorn sentinel_omega.infrastructure.dashboard.api:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
