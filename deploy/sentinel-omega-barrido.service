[Unit]
Description=Sentinel Omega — Barrido diario
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__REPO_DIR__/deploy/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m sentinel_omega.launcher --barrido
Nice=10

# Sin [Install]: es una tarea que se corre a mano o desde el barrido diario.
# Un `enable` la lanzaría en cada arranque de sesión.
