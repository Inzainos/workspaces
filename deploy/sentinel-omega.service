# Unit de USUARIO systemd -> ~/.config/systemd/user/sentinel-omega.service
# Instalar con: bash deploy/install.sh  (sin sudo)
# NO copiar a /etc/systemd/system: la unit de sistema homonima debe seguir
# ENMASCARADA (-> /dev/null) para no tener dos launchers peleando.
# %h = $HOME del usuario (en vivo: /home/deamon); el repo vive en %h/workspaces.
[Unit]
Description=Sentinel Omega - Precursor Detection Platform (Fractal Core)
# Wants= (2026-09-28): levantar Sentinel levanta los dashboards. El orden lo
# ponen las units mismas (api: After=sentinel-omega; web: Wants+After=api).
# Si dashboard-web no existe en esta instalación, systemd solo avisa en el
# journal — Sentinel arranca igual, y el watchdog re-levantará lo que exista.
Wants=sentinel-omega-dashboard-api.service sentinel-omega-dashboard-web.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/workspaces
EnvironmentFile=%h/workspaces/deploy/.env
ExecStartPre=/bin/rm -f %h/workspaces/sentinel_omega/data/sentinel_omega.pid
ExecStart=%h/workspaces/.venv/bin/python sentinel_omega/launcher.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
