# Unit de USUARIO systemd -> ~/.config/systemd/user/sentinel-omega-watchdog.service
# Instalar con: bash deploy/install.sh  (sin sudo)
# NO copiar a /etc/systemd/system: la unit de sistema homonima debe seguir
# ENMASCARADA (-> /dev/null). El watchdog reinicia con `systemctl --user`.
[Unit]
Description=Sentinel Omega — Watchdog red y agente (auto-levanta sistema)
After=sentinel-omega.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/workspaces
EnvironmentFile=-%h/workspaces/deploy/.env
ExecStart=%h/workspaces/.venv/bin/python -m sentinel_omega.infrastructure.watchdog.network_watchdog
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
