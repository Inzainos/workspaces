[Unit]
Description=Sentinel Omega — Retrain ONNX semanal (desde TBL_FIRMAS)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Unit de USUARIO desde el 2026-10-08. Antes era de SISTEMA y necesitaba tres
# líneas de andamio para poder hablar con el gestor de usuario: `User=` para
# correr como el dueño de los archivos (DB, modelos, logs), y XDG_RUNTIME_DIR +
# DBUS_SESSION_BUS_ADDRESS para que el `systemctl --user restart` del
# ExecStartPost encontrara el bus. Como unit de usuario las tres sobran --- y
# `User=` además es INVÁLIDO en el gestor de usuario, que rechaza la unit ---
# porque ya corre como el usuario y ya tiene su bus.
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__REPO_DIR__/deploy/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m sentinel_omega.models.train_onnx_from_db --db-path sentinel_omega/data/SENTINEL_OMEGA_PRO.db --min-samples 50
ExecStartPost=/bin/sh -c 'systemctl --user is-active --quiet sentinel-omega.service && systemctl --user restart sentinel-omega.service || true'
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Sin [Install]: la dispara su timer. Con un [Install] un `enable` accidental
# lanzaría un reentrenamiento ONNX completo en cada arranque de sesión. Es la
# misma forma que `sentinel-omega-mantenimiento.service`, que lleva la nota.
